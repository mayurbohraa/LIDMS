# Private local file: copy to .env.neon after creating/connecting Neon.
# Normal localhost startup reads only these two URLs from this file.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Explicit maintenance commands also use the following settings.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
LIDMS_REQUIRE_POSTGRES=true
LIDMS_DEMO_MODE=true
LIDMS_SHOW_DEMO_ACCOUNTS=true
LIDMS_DEMO_PASSWORD=
