# Local development: copy to .env. Vercel: configure these in Project Settings.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Leave blank locally for SQLite. Vercel requires Neon PostgreSQL with SSL.
DATABASE_URL=
# Optional: publish sample account details on the login page of a demo installation.
LIDMS_SHOW_DEMO_ACCOUNTS=false
LIDMS_DEMO_MODE=false
LIDMS_DEMO_PASSWORD=
