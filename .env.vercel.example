# Import the private .env.vercel into Vercel's Production environment.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
LIDMS_REQUIRE_POSTGRES=true
LIDMS_DEMO_MODE=true
LIDMS_SHOW_DEMO_ACCOUNTS=true
LIDMS_DEMO_PASSWORD=
# Neon integration supplies DATABASE_URL. Do not overwrite it with a blank value.
# Vercel's assigned domains are trusted automatically; add a custom domain later.
